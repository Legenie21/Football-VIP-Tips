# Modèle uniquement : aucune connexion n'est activée par ce fichier.
# Renseigner ces variables côté serveur lors du raccordement à Cybrancee.
# Ne jamais les placer dans des variables VITE_* ou dans Git.

# Choisir le moteur réellement fourni : mysql (inclut MariaDB) ou postgres.
CYBRANCEE_DB_CLIENT=
CYBRANCEE_DB_HOST=
CYBRANCEE_DB_PORT=
CYBRANCEE_DB_NAME=
CYBRANCEE_DB_USER=
CYBRANCEE_DB_PASSWORD=
# TLS vérifié par défaut. Ne désactiver que selon les instructions de l'hébergeur.
CYBRANCEE_DB_TLS=true
CYBRANCEE_DB_CA=
CYBRANCEE_DB_POOL_SIZE=5

# SMTP est indépendant de la base de données.
# Utiliser le serveur de messagerie fourni par votre hébergeur ou votre messagerie.
SMTP_HOST=
SMTP_PORT=587
# starttls : généralement port 587 ; tls : généralement port 465.
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Une adresse d'expédition seule, par exemple no-reply@votre-domaine.tld.
SMTP_FROM=

# Adresse HTTPS réelle du site, à renseigner au raccordement.
AUTH_PUBLIC_ORIGIN=
# Secret aléatoire dédié aux futurs codes OTP, au moins 32 caractères.
AUTH_OTP_SECRET=
# SESSION_SECRET est le secret serveur déjà prévu par le projet.
# À définir dans le gestionnaire de secrets s'il n'est pas déjà configuré.
SESSION_SECRET=
